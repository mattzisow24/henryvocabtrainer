# Copy to .env.local for local development, and add the same values in Vercel.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude (the coach): console.anthropic.com
ANTHROPIC_API_KEY=

# Optional
# NEXT_PUBLIC_TEST_DATE=2026-12-05   # the SAT sitting the pacing aims at
# NEXT_PUBLIC_LEARNER_NAME=Henry
# COACH_MODEL=claude-opus-5-5

# Daily email to parents (optional). Sent each evening by the schedule in vercel.json.
# SUPABASE_SECRET_KEY=        # Supabase "secret" key; lets the scheduled job read the data
# CRON_SECRET=                # any long random string; Vercel sends it with the scheduled call
# GMAIL_USER=                 # the Gmail address the email is sent from
# GMAIL_APP_PASSWORD=         # a Google app password for that account (not the normal password)
# Or, in place of the two GMAIL_ values, send through Resend:
# RESEND_API_KEY=
# EMAIL_FROM=                 # e.g. "SAT Vocab <coach@yourdomain.com>", on a domain verified in Resend
